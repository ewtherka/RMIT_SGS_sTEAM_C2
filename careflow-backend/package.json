{
  "name": "careflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Patient-focused CareFlow backend for RMIT UNLOCKED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-policy.mjs",
    "start": "node dist/src/main.js",
    "dev": "npm run build && node scripts/dev.mjs",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "seed": "npm run build && node dist/scripts/seed.js",
    "openapi": "npm run build && node dist/scripts/openapi.js",
    "link-user": "npm run build && node dist/scripts/link-user.js",
    "tide:check": "npm run build && node dist/scripts/tide-check.js",
    "milvus:check": "npm run build && node dist/scripts/milvus-check.js",
    "format": "prettier --write src test scripts package.json tsconfig.json",
    "format:check": "prettier --check src test scripts package.json tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@tidecloak/verify": "0.14.33",
    "@tideorg/js": "0.14.29",
    "@zilliz/milvus2-sdk-node": "3.0.6",
    "dotenv": "18.0.8",
    "helmet": "8.3.0",
    "jose": "6.2.13",
    "luxon": "3.7.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
